#!/usr/bin/zsh

# Powerlevel10k instant prompt: draws the prompt from cache immediately while the rest
# of this file loads. Must stay near the top; anything needing console input goes above it.
# quiet: iTerm2 shell integration prints escape codes at startup, which are harmless
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Prevent initialization of completion system before zim
skip_global_compinit=1

# Docker CLI completions (added to fpath before zim runs compinit)
fpath=(/Users/mitochondrium/.docker/completions $fpath)

# Load environment variables first
source ~/.env

# Set default editor
export EDITOR='zed'

# Theme Configuration
POWERLEVEL9K_MODE='nerdfont-complete'
POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(dir virtualenv anaconda vcs)
POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(status time)
POWERLEVEL9K_TIME_FORMAT="%D{ %H:%M:%S}"
POWERLEVEL9K_STATUS_VERBOSE=false
POWERLEVEL9K_PROMPT_ON_NEWLINE=true
POWERLEVEL9K_VCS_GIT_ICON=
POWERLEVEL9K_MULTILINE_SECOND_PROMPT_PREFIX="\u2570\uf460 "

# Differentiate venv vs conda visually
POWERLEVEL9K_VIRTUALENV_BACKGROUND='033'       # blue
POWERLEVEL9K_VIRTUALENV_FOREGROUND='white'
POWERLEVEL9K_VIRTUALENV_VISUAL_IDENTIFIER_EXPANSION=''   # Python logo
POWERLEVEL9K_ANACONDA_BACKGROUND='028'         # green
POWERLEVEL9K_ANACONDA_FOREGROUND='white'
POWERLEVEL9K_ANACONDA_VISUAL_IDENTIFIER_EXPANSION='🐍'         # snake

# History configuration
HISTFILE="${HOME}/.zshhistory"
setopt HIST_IGNORE_ALL_DUPS
setopt append_history
setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt inc_append_history
setopt share_history
setopt autocd

# Path configuration
typeset -U path
path=(
    $HOME/.local/bin
    /opt/homebrew/opt/llvm/bin
    /opt/homebrew/opt/openjdk/bin
    $HOME/.cargo/bin
    $HOME/go/bin
