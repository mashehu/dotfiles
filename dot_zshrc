# brew update + upgrade + cleanup, with a semver-colored upgrade preview
function brewup() {
    brew update || return

    # Let brew compute the upgrade set itself, so the preview matches what will actually run
    local preview
    preview=$(brew upgrade --dry-run "$@" 2>&1) || { print -r -- "$preview"; return 1 }

    if [[ $preview != *"Would upgrade"* ]]; then
        print -r -- "$preview"
        print -P "%B%F{blue}==>%f Running brew cleanup...%b"; brew cleanup
        return
    fi

    # Map each package to its GitHub releases page (name<TAB>url per line), found in the
    # formula/cask source, head or homepage URLs; packages not hosted on GitHub get no link
    local -a names
    names=(${(f)"$(print -r -- "$preview" | awk '/^==> Would upgrade/ { f = 1; next } /^==>/ { f = 0 } f && / -> / { print $1 }')"})
    local links
    # one unresolvable name fails the whole lookup, so fall back to the (slower) full installed set
    links=$({ brew info --json=v2 "${names[@]}" || brew info --json=v2 --installed } 2>/dev/null | jq -r '
        def repo: [.[] | strings | capture("github\\.com/(?<r>[^/]+/[^/#?]+)").r | sub("\\.git$"; "")] | first;
        (.formulae[] | {k: [.name, .full_name], r: ([.urls.stable.url, .urls.head.url, .homepage] | repo)}),
        (.casks[]    | {k: [.token, .full_token], r: ([.url, .homepage] | repo)})
        | select(.r) | .k[] as $k | "\($k)\thttps://github.com/\(.r)/releases"')

    # Color the new version: red = major, yellow = minor, green = patch, dim = revision/build only.
    # Only the part from the first changed component onward is colored.
    print -r -- "$preview" | LINKS=$links awk '
        BEGIN {
            n = split(ENVIRON["LINKS"], rows, "\n")
            for (i = 1; i <= n; i++) if (split(rows[i], kv, "\t") == 2) url[kv[1]] = kv[2]
        }
        /^==> Would upgrade/ { in_list = 1; print; next }
        /^==>/ { in_list = 0 }
        in_list && match($0, /-> [^ ]+/) {
            new = substr($0, RSTART + 3, RLENGTH - 3)
            old = $0; sub(/ +-> .*/, "", old); sub(/.* /, "", old)
            # compare only the dotted base version; "_1" revisions and ",abc123" cask builds are ignored
            o = old; sub(/[_,].*/, "", o)
            n = new; sub(/[_,].*/, "", n)
            no = split(o, op, "."); nn = split(n, np, ".")
            idx = 0
            for (i = 1; i <= (nn > no ? nn : no); i++)
                if (op[i] != np[i]) { idx = i; break }
            color = idx == 1 ? "\033[1;31m" : idx == 2 ? "\033[1;33m" : idx ? "\033[32m" : "\033[2m"
            pos = 1
            for (i = 1; i < idx; i++) pos += length(np[i]) + 1
            # base version (colored from pos on), then any revision/build suffix dimmed
            base = substr(new, 1, length(n)); suffix = substr(new, length(n) + 1)
            if (idx) out = substr(base, 1, pos - 1) color substr(base, pos) "\033[0m" (suffix != "" ? "\033[2m" suffix "\033[0m" : "")
            else     out = base color suffix "\033[0m"
            # package name gets the same color as its version bump, and links (OSC 8) to its GitHub releases
            name = $1
            label = color name "\033[0m"
            if (name in url) label = "\033]8;;" url[name] "\033\\" label "\033]8;;\033\\"
            print label substr($0, length(name) + 1, RSTART + 2 - length(name)) out substr($0, RSTART + RLENGTH)
            next
        }
        { print }
    '

    print -P '\n%B%F{red}major%f%b  %B%F{yellow}minor%f%b  %F{green}patch%f  \e[2mrevision/build\e[0m'
    local answer
    read -r "answer?Proceed with upgrade? [Y/n] "
    case $answer in
        ""|[yY]|[yY]es) brew upgrade --yes "$@" && rm -f "${ZSH_EVALCACHE_DIR:-$HOME/.zsh-evalcache}"/init-*(N) && print -P "%B%F{blue}==>%f Running brew cleanup...%b" && brew cleanup ;;
        *) echo "Aborted."; return 1 ;;
    esac
}

# Auto ls after cd
function _auto_ls() {
    emulate -L zsh
    eza --icons --all --color=always --group-directories-first
}

typeset -ga chpwd_functions
if [[ ${chpwd_functions[(r)_auto_ls]} != "_auto_ls" ]]; then
    chpwd_functions+=(_auto_ls)
fi

# F-Sy-H chroma painting subcommands up to three levels deep (`gh pr checkout`,
# `docker compose up`), but only names the tool actually has. The built-in generic
# chroma paints any first word. Valid names are parsed from `<cmd> [words] --help`
# (or `<cmd> help [words]`) in the background and cached on disk for a week
typeset -ga _fsh_subcmd_commands=(
    gh docker kubectl mise uv pixi rustup conda terraform nf-core nextflow brew go
)
# Commands whose --help doesn't list all subcommands: arguments that print them instead
typeset -gA _fsh_subcmd_listers=(
    brew 'commands --quiet --include-aliases'
)
typeset -g _fsh_subcmd_dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh-subcmd
typeset -gA _fsh_subcmd_cache

# Writes the subcommand names of command path $1 (e.g. "gh pr") to
# $_fsh_subcmd_dir/gh/pr.list; writes nothing if the tool fails, so a later shell retries
function _fsh_subcmd_probe() {
    emulate -L zsh
    local -a words=( ${=1} ) tries names
    local exe out line args file=$_fsh_subcmd_dir/${1// //}.list
    integer ok=0
    # First executable in PATH; $commands may point at a broken symlink
    for exe in $(whence -ap $words[1]); do [[ -x $exe ]] && break; done
    [[ -x $exe ]] || return

    if (( $#words == 1 )) && [[ -n ${_fsh_subcmd_listers[$words[1]]} ]]; then
        tries=( ${_fsh_subcmd_listers[$words[1]]} )
    else
        tries=( "${words[2,-1]} --help" "help ${words[2,-1]}" )
    fi
    for args in $tries; do
        out=$(PAGER=cat GH_PAGER=cat MANPAGER=cat NO_COLOR=1 TERM=dumb \
            perl -e 'alarm shift; exec @ARGV' 10 $exe ${=args} </dev/null 2>&1) && ok=1
        # Indented lowercase name, then a description, a `<arg>`, or nothing:
        # `  checkout:   Check out…`, `  compose*  Docker Compose`, `  install <id>`
        for line in ${(f)out}; do
            [[ $line =~ '^[[:blank:]]{0,8}([a-z][a-z0-9_-]*)\*?(:?([[:blank:]]{2,}|$)|:? [<[])' ]] \
                && names+=( $match[1] )
        done
        (( $#names )) && break
    done
    (( $#names || ok )) || return

    mkdir -p ${file:h}
    print -r -- ${(u)names} >| $file.$$
    mv -f $file.$$ $file
}

function _fsh_chroma_subcmd() {
    builtin emulate -L zsh
    builtin setopt extended_glob

    (( next_word = (this_word & BIT_case_code) | 2 | 8192 ))
    [[ $__arg_type == 3 ]] && return 2

    local __first_call=$1 __wrd=$2 __start_pos=$3 __end_pos=$4

    if (( __first_call )); then
        _fsh_state[chroma-subcmd-path]=${__wrd:t}
        return 1
    elif (( in_redirection > 0 || this_word & 128 )) || [[ $__wrd == "<<<" || $__wrd == -*=* ]]; then
        return 1
    fi

    # Release the takeover unless this word is a valid subcommand of the path so far
    (( next_word &= ~8192 ))
    [[ $__wrd == [[:alpha:]][[:alnum:]_-]# ]] || return 1

    local key=${_fsh_state[chroma-subcmd-path]} names
    local file=$_fsh_subcmd_dir/${key// //}.list
    names=${_fsh_subcmd_cache[$key]}
    if [[ ( -z $names || $names == pending ) && -r $file ]]; then
        names=" $(<$file) "
        _fsh_subcmd_cache[$key]=$names
        local -a stale=( $file(Nm+7) )
        (( $#stale )) && _fsh_subcmd_probe $key &>/dev/null &!
    elif [[ -z $names ]]; then
        _fsh_subcmd_cache[$key]=pending
        _fsh_subcmd_probe $key &>/dev/null &!
    fi
    [[ $names == *" $__wrd "* ]] || return 1

    _fsh_state[chroma-subcmd-path]+=" $__wrd"
    (( ${#${=_fsh_state[chroma-subcmd-path]}} < 4 )) && (( next_word |= 8192 ))

    (( __start = __start_pos - ${#PREBUFFER}, __end = __end_pos - ${#PREBUFFER}, __start >= 0 )) \
        && reply+=("$__start $__end ${_fsh_styles[${_fsh_theme_name}subcommand]}")
    (( this_word = next_word ))
    _start_pos=$_end_pos
    return 0
}
if (( ${+_fsh_state} )); then
    for cmd in $_fsh_subcmd_commands; do
        _fsh_state[chroma-$cmd]=_fsh_chroma_subcmd
    done
    unset cmd
fi

