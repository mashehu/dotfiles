# gnew <branch> [base]: fetch upstream (origin if there is none) and branch off it directly,
# without touching the local master/main/dev. Base defaults to <remote>/dev if it exists
# (nf-core convention), else the remote's default branch.
function gnew() {
    [[ -n $1 ]] || { echo "usage: gnew <branch> [base]" >&2; return 1; }
    local remote=upstream base=$2
    git remote get-url upstream &>/dev/null || remote=origin
    git fetch "$remote" || return
    if [[ -z $base ]]; then
        if git rev-parse --verify -q "$remote/dev" >/dev/null; then
            base=$remote/dev
        else
            base=$(git rev-parse --abbrev-ref "$remote/HEAD" 2>/dev/null) \
                || { git remote set-head "$remote" --auto >/dev/null \
                     && base=$(git rev-parse --abbrev-ref "$remote/HEAD"); } \
                || return
        fi
    elif [[ $base != */* ]]; then
        base=$remote/$base
    fi
    git switch -c "$1" --no-track "$base"
}

# nfc <repo>: cd into ~/<repo> (or ~/nf-core_<repo>, e.g. modules, website, .github),
# forking + cloning it into ~/<repo> first if neither exists.
# Bare names are nf-core repos (nfc rnaseq); owner/repo and GitHub URLs work too.
# gh sets the remotes up as origin = your fork, upstream = the original.
function nfc() {
    [[ -n $1 ]] || { echo "usage: nfc <repo|owner/repo|github-url>" >&2; return 1; }
    local slug=${${1#https://github.com/}%.git}
    slug=${slug%/}
    [[ $slug == */* ]] || slug=nf-core/$slug
    local dir=${slug:t}
    [[ $slug == nf-core/* && ! -d ~/$dir && -d ~/nf-core_${dir#.} ]] && dir=nf-core_${dir#.}
    if [[ ! -d ~/$dir ]]; then
        (cd ~ && gh repo fork "$slug" --clone) || return
    fi
    cd ~/$dir
}
compdef '_files -W ~ -/' nfc

function ezad() {
    if [ $# -eq 0 ]; then
        eza --icons --all --color=always --group-directories-first
    else
        eza --icons --all --color=always --group-directories-first "$@"
    fi
}

